#--------------------------------------------------------------------
# CONFIGURACIÓN DE ENTORNO (CodeIgniter 4)
# Renombrar o copiar este archivo como ".env" antes de ejecutar
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# URL BASE DEL PROYECTO
# Ajustar según la ruta donde se aloje en el servidor local (XAMPP/WAMP)
#--------------------------------------------------------------------

app.baseURL = 'http://localhost/viajes/public/'

#--------------------------------------------------------------------
# BASE DE DATOS (MySQL / MariaDB)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = viajes_rosario
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306